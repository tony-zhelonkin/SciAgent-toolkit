#!/usr/bin/env bash
# sciagent — project bindings, CRAFT rendering, and guardrail checks.

set -u

_self="${BASH_SOURCE[0]}"
while [[ -L "$_self" ]]; do
    _target=$(readlink "$_self")
    [[ "$_target" == /* ]] && _self="$_target" || _self="$(dirname "$_self")/$_target"
done
SCIAGENT_BIN="$(cd "$(dirname "$_self")" && pwd)"
SCIAGENT_TOOLKIT="${SCIAGENT_TOOLKIT:-$(cd "$SCIAGENT_BIN/.." && pwd)}"
if [[ ! -d "$SCIAGENT_TOOLKIT" ]]; then
    echo "sciagent: toolkit directory does not exist: $SCIAGENT_TOOLKIT" >&2
    exit 1
fi
SCIAGENT_TOOLKIT="$(cd "$SCIAGENT_TOOLKIT" && pwd -P)"
export SCIAGENT_TOOLKIT

LIB="$SCIAGENT_TOOLKIT/lib/sciagent"

usage() {
    cat <<EOF
sciagent — project bindings, CRAFT rendering, and guardrail checks

Usage:
  sciagent craft [--project-dir D] [--force] [--quiet]
                                       Render the SCIAGENT:CRAFT block
  sciagent link [--project-dir D]      Link catalog trees and ensure hooks
  sciagent lint [--project-dir D] [--check <name>...] [--strict] [--quiet]
                                       Run project guardrail checks
  sciagent validate [--quiet]          Validate toolkit catalog metadata
  sciagent gitignore [<path>]          Refresh SCIAGENT:GITIGNORE
  sciagent --help                      This message

Toolkit: $SCIAGENT_TOOLKIT
EOF
}

[[ $# -gt 0 ]] || { usage; exit 1; }
verb="$1"
shift

case "$verb" in
    -h|--help|help)
        usage
        exit 0 ;;
    craft)
        modules="block.sh craft.sh craft_verb.sh"
        entry=cmd_craft ;;
    link)
        modules="block.sh ownership.sh claude_settings.sh link.sh"
        entry=cmd_link ;;
    lint)
        modules="block.sh craft.sh lint.sh"
        entry=cmd_lint ;;
    validate)
        modules="block.sh craft.sh collisions.sh lint.sh validate.sh"
        entry=cmd_validate ;;
    gitignore)
        modules="gitignore.sh"
        entry=cmd_gitignore ;;
    *)
        echo "sciagent: unknown verb '$verb'" >&2
        usage >&2
        exit 1 ;;
esac

for module in $modules; do
    # shellcheck source=/dev/null
    . "$LIB/$module"
done
"$entry" "$@"
