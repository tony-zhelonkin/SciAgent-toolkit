#!/usr/bin/env bash
# sciagent — per-project AI-harness context manager.
# Resolves library path relative to this script's real location.

set -u

# Resolve real path (follow symlinks).
_self="${BASH_SOURCE[0]}"
while [[ -L "$_self" ]]; do
    _link=$(readlink "$_self")
    [[ "$_link" == /* ]] && _self="$_link" || _self="$(dirname "$_self")/$_link"
done
SCIAGENT_BIN="$(cd "$(dirname "$_self")" && pwd)"
if [[ -z "${SCIAGENT_TOOLKIT:-}" ]]; then
    SCIAGENT_TOOLKIT="$(cd "$SCIAGENT_BIN/.." && pwd)"
fi
export SCIAGENT_TOOLKIT

LIB="$SCIAGENT_TOOLKIT/lib/sciagent"

usage() {
    cat <<EOF
sciagent — per-project AI-harness context manager

Usage:
  sciagent activate <base> [overlay]   Activate role(s) (max stack depth 2)
  sciagent deactivate [<role>]         Tear down the stack (or one role)
  sciagent validate [--quiet]          Check requires graph + tag-vocab compliance
  sciagent inject <skill>              Add one skill to current overlay
  sciagent inject --tag <name>         Add all skills tagged <name>
  sciagent eject <skill>               Remove one previously-injected skill
  sciagent eject --tag <name>          Remove all skills injected via tag
  sciagent status [--json|--effective|--source <name>]
                                       Report active stack and effective tables
  sciagent list [roles|skills|agents|commands]
                                       List available content
  sciagent list deps <skill>           Transitive requires closure (leaves first)
  sciagent list dependents <skill>     Direct dependents (skills that require <skill>)
  sciagent new project|role|skill|agent [args]
                                       Scaffold from templates
  sciagent --help                      This message

Toolkit: $SCIAGENT_TOOLKIT
EOF
}

if [[ $# -eq 0 ]]; then
    usage
    exit 1
fi

verb="$1"; shift

case "$verb" in
    -h|--help|help)
        usage; exit 0 ;;
    activate)
        # shellcheck source=/dev/null
        . "$LIB/block.sh"
        . "$LIB/symlinks.sh"
        . "$LIB/roles.sh"
        . "$LIB/skill_deps.sh"
        . "$LIB/validate.sh"
        . "$LIB/stack.sh"
        . "$LIB/claude_settings.sh"
        . "$LIB/activate.sh"
        cmd_activate "$@"
        ;;
    deactivate)
        . "$LIB/block.sh"
        . "$LIB/symlinks.sh"
        . "$LIB/roles.sh"
        . "$LIB/skill_deps.sh"
        . "$LIB/validate.sh"
        . "$LIB/stack.sh"
        . "$LIB/claude_settings.sh"
        . "$LIB/activate.sh"      # deactivate may re-activate solo-base
        . "$LIB/deactivate.sh"
        cmd_deactivate "$@"
        ;;
    inject)
        . "$LIB/block.sh"
        . "$LIB/symlinks.sh"
        . "$LIB/roles.sh"
        . "$LIB/skill_deps.sh"
        . "$LIB/stack.sh"
        . "$LIB/inject.sh"
        cmd_inject "$@"
        ;;
    eject)
        . "$LIB/block.sh"
        . "$LIB/symlinks.sh"
        . "$LIB/roles.sh"
        . "$LIB/skill_deps.sh"
        . "$LIB/stack.sh"
        . "$LIB/inject.sh"
        . "$LIB/eject.sh"
        cmd_eject "$@"
        ;;
    status)
        . "$LIB/block.sh"
        . "$LIB/symlinks.sh"
        . "$LIB/roles.sh"
        . "$LIB/skill_deps.sh"
        . "$LIB/stack.sh"
        . "$LIB/status.sh"
        cmd_status "$@"
        ;;
    list)
        . "$LIB/roles.sh"
        . "$LIB/skill_deps.sh"
        . "$LIB/status.sh"
        cmd_list "$@"
        ;;
    validate)
        . "$LIB/skill_deps.sh"
        . "$LIB/validate.sh"
        cmd_validate "$@"
        ;;
    new)
        . "$LIB/new.sh"
        cmd_new "$@"
        ;;
    *)
        echo "sciagent: unknown verb '$verb'" >&2
        usage
        exit 1
        ;;
esac
