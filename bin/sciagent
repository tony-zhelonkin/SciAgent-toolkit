#!/usr/bin/env bash
# sciagent — per-project AI-harness context manager.
# Resolves library path relative to this script's real location.

set -u

# Resolve real path (follow symlinks).
_self="${BASH_SOURCE[0]}"
while [[ -L "$_self" ]]; do
    _link=$(readlink "$_self")
    [[ "$_link" == /* ]] && _self="$_link" || _self="$(dirname "$_self")/$_link"
done
SCIAGENT_BIN="$(cd "$(dirname "$_self")" && pwd)"
if [[ -z "${SCIAGENT_TOOLKIT:-}" ]]; then
    SCIAGENT_TOOLKIT="$(cd "$SCIAGENT_BIN/.." && pwd)"
fi
export SCIAGENT_TOOLKIT

LIB="$SCIAGENT_TOOLKIT/lib/sciagent"

usage() {
    cat <<EOF
sciagent — per-project AI-harness context manager

Usage:
  sciagent activate <base> [overlay]   Activate role(s) (max stack depth 2)
  sciagent deactivate [<role>]         Tear down the stack (or one role)
  sciagent validate [--quiet]          Check requires graph + tag-vocab compliance
                                       Force resolution to one kind
                                       Disambiguate when same name spans kinds
  sciagent status [--json|--effective|--source <name>]
                                       Report active stack and effective tables
  sciagent list [roles|skills|agents|commands]
                                       List available content
  sciagent list role <name>            Detailed view of a specific role
  sciagent list deps <skill>           Transitive requires closure (leaves first)
  sciagent list dependents <skill>     Direct dependents (skills that require <skill>)
  sciagent new project|role|skill|agent [args]
                                       Scaffold from templates
  sciagent craft [--project-dir D] [--force] [--quiet]
                                       Render/refresh the SCIAGENT:CRAFT block in
                                       D/AGENTS.md; mounts nothing
  sciagent gitignore [<path>]          Add/update SCIAGENT:GITIGNORE block in .gitignore
  sciagent update [--to <ref>] [--no-pin] [--quiet]
                                       Re-pin toolkit submodule + re-activate current stack
  sciagent provision [--harness <csv|all>] [--user] [--context] [--settings] [--dry-run]
                                       Seed user-level / global context + settings per harness
  sciagent --help                      This message

Toolkit: $SCIAGENT_TOOLKIT
EOF
}

if [[ $# -eq 0 ]]; then
    usage
    exit 1
fi

verb="$1"; shift

# ---------------------------------------------------------------------------
# Verb → module load graph.
#
# Layering DAG (each module depends only on those listed above it; sourcing is
# centralised here, so source-time cycles are impossible by construction):
#
#   block.sh            leaf: managed-block file I/O + hashing, no sciagent deps
#   craft.sh            CRAFT block renderer (depends on block.sh)
#   craft_verb.sh       `craft` verb: block-only render (depends on block.sh, craft.sh)
#   frontmatter.sh      leaf: YAML frontmatter parser, no sciagent deps
#   roles.sh            leaf: role/skill YAML reads
#   symlinks.sh         manifest state + symlink trees (depends on roles.sh)
#   skill_deps.sh       requires-graph resolver (depends on roles.sh)
#   collisions.sh       leaf: toolkit enumeration; reads collision allowlist
#   stack.sh            stack walk + block_render_and_write (depends on roles.sh, block.sh)
#   claude_settings.sh  settings.local.json apply/revert (leaf-ish)
#   validate.sh         depends on skill_deps.sh, collisions.sh
#   activate.sh         depends on ~everything above
#   deactivate.sh       depends on activate.sh (may re-activate solo-base)
#   status.sh           depends on stack.sh, collisions.sh, roles.sh; lazy-loads frontmatter.sh
#   update.sh           depends on activate.sh closure + craft.sh (re-pin + re-activate)
#
# Each row below lists exactly a verb's transitive closure, in dependency order.
# ---------------------------------------------------------------------------
declare -A VERB_MODULES=(
    [activate]="block.sh craft.sh symlinks.sh roles.sh skill_deps.sh collisions.sh validate.sh stack.sh claude_settings.sh activate.sh"
    [deactivate]="block.sh craft.sh symlinks.sh roles.sh skill_deps.sh collisions.sh validate.sh stack.sh claude_settings.sh activate.sh deactivate.sh"
    [status]="block.sh symlinks.sh roles.sh skill_deps.sh stack.sh collisions.sh status.sh"
    [list]="roles.sh skill_deps.sh status.sh"
    [validate]="block.sh craft.sh skill_deps.sh collisions.sh validate.sh"
    [new]="new.sh"
    [craft]="block.sh craft.sh craft_verb.sh"
    [gitignore]="gitignore.sh"
    [update]="block.sh craft.sh symlinks.sh roles.sh skill_deps.sh collisions.sh validate.sh stack.sh claude_settings.sh activate.sh update.sh"
    [provision]="block.sh harness.sh claude_settings.sh provision.sh"
)

# Verb → cmd_* entrypoint.
declare -A VERB_ENTRY=(
    [activate]=cmd_activate
    [deactivate]=cmd_deactivate
    [status]=cmd_status
    [list]=cmd_list
    [validate]=cmd_validate
    [new]=cmd_new
    [craft]=cmd_craft
    [gitignore]=cmd_gitignore
    [update]=cmd_update
    [provision]=cmd_provision
)

# ---------------------------------------------------------------------------
# Mutating verbs — those that write symlinks/blocks into the project. Guarded
# by _guard_toolkit_locality (see below). deactivate is intentionally NOT
# guarded: it only removes what its own manifest owns, so it is safe (and
# desirable) to run even against an external toolkit to clean up.
# ---------------------------------------------------------------------------
declare -A MUTATING_VERB=(
    [activate]=1
)

# _guard_toolkit_locality
# Reproducibility guard: if this project ships its own toolkit at
# ./01_modules/SciAgent-toolkit, refuse to mutate it using an EXTERNAL/global
# toolkit (e.g. a checkout under /data1 or a container /workspaces path). Doing
# so would symlink the project against — and pin its .claude/.agents links to —
# the wrong toolkit, silently escaping the submodule pin and breaking
# portability. "In-repo" is decided by real-path equality between
# $SCIAGENT_TOOLKIT and ./01_modules/SciAgent-toolkit.
#
# Escape hatches for intentional cross-toolkit use:
#   --allow-external-toolkit            (per-invocation flag, stripped here)
#   SCIAGENT_ALLOW_EXTERNAL_TOOLKIT=1   (env var)
_guard_toolkit_locality() {
    local in_repo="./01_modules/SciAgent-toolkit"
    # No in-repo toolkit → nothing to protect; any resolution is fine.
    [[ -d "$in_repo" ]] || return 0

    local in_repo_real active_real
    if command -v realpath >/dev/null 2>&1; then
        in_repo_real="$(realpath "$in_repo" 2>/dev/null || printf '%s' "$in_repo")"
        active_real="$(realpath "$SCIAGENT_TOOLKIT" 2>/dev/null || printf '%s' "$SCIAGENT_TOOLKIT")"
    else
        in_repo_real="$(cd "$in_repo" 2>/dev/null && pwd -P || printf '%s' "$in_repo")"
        active_real="$(cd "$SCIAGENT_TOOLKIT" 2>/dev/null && pwd -P || printf '%s' "$SCIAGENT_TOOLKIT")"
    fi

    # Resolved toolkit already IS the in-repo one → allowed.
    [[ "$active_real" == "$in_repo_real" ]] && return 0

    # Mismatch: external toolkit while an in-repo one exists.
    echo "sciagent: refusing to $verb against an external toolkit" >&2
    echo "  active toolkit : $active_real" >&2
    echo "  in-repo toolkit: $in_repo_real" >&2
    echo "  This project ships its own toolkit; using an external one would symlink" >&2
    echo "  .claude/.agents against the wrong copy and escape the submodule pin." >&2
    echo "  Fix by one of:" >&2
    echo "    - run ./01_modules/SciAgent-toolkit/bin/sciagent $verb ..." >&2
    echo "    - export SCIAGENT_TOOLKIT=$in_repo_real" >&2
    echo "    - pass --allow-external-toolkit (or set SCIAGENT_ALLOW_EXTERNAL_TOOLKIT=1) to override" >&2
    return 1
}

case "$verb" in
    -h|--help|help)
        usage; exit 0 ;;
    *)
        if [[ -z "${VERB_MODULES[$verb]:-}" ]]; then
            echo "sciagent: unknown verb '$verb'" >&2
            usage
            exit 1
        fi

        # Strip the toolkit-locality override flag from the arg list (it is not
        # a verb argument) and record whether the override was requested.
        _allow_external="${SCIAGENT_ALLOW_EXTERNAL_TOOLKIT:-0}"
        _verb_args=()
        for _a in "$@"; do
            if [[ "$_a" == "--allow-external-toolkit" ]]; then
                _allow_external=1
            else
                _verb_args+=("$_a")
            fi
        done
        set -- "${_verb_args[@]+"${_verb_args[@]}"}"

        # Toolkit-locality guard runs before any mutating verb touches the FS.
        if [[ -n "${MUTATING_VERB[$verb]:-}" && "$_allow_external" != "1" ]]; then
            _guard_toolkit_locality || exit 1
        fi

        # shellcheck source=/dev/null
        for _mod in ${VERB_MODULES[$verb]}; do
            . "$LIB/$_mod"
        done
        "${VERB_ENTRY[$verb]}" "$@"
        exit $?
        ;;
esac
