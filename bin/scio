#!/usr/bin/env bash
# scio — project bindings, CRAFT rendering, and guardrail checks.

set -u

_self="${BASH_SOURCE[0]}"
while [[ -L "$_self" ]]; do
    _target=$(readlink "$_self")
    [[ "$_target" == /* ]] && _self="$_target" || _self="$(dirname "$_self")/$_target"
done
SCIO_BIN="$(cd "$(dirname "$_self")" && pwd)"
SCIO_TOOLKIT="${SCIO_TOOLKIT:-$(cd "$SCIO_BIN/.." && pwd)}"
if [[ ! -d "$SCIO_TOOLKIT" ]]; then
    echo "scio: toolkit directory does not exist: $SCIO_TOOLKIT" >&2
    exit 1
fi
SCIO_TOOLKIT="$(cd "$SCIO_TOOLKIT" && pwd -P)"
export SCIO_TOOLKIT

LIB="$SCIO_TOOLKIT/lib/scio"

usage() {
    cat <<EOF
scio — project bindings, CRAFT rendering, and guardrail checks

Usage:
  scio craft [--project-dir D] [--force] [--quiet]
                                       Render the SCIO:CRAFT block
  scio link [--project-dir D]      Link catalog trees and ensure hooks
  scio lint [--project-dir D] [--check <name>...] [--strict] [--quiet]
                                       Run project guardrail checks
  scio --help                      This message

Toolkit: $SCIO_TOOLKIT
EOF
}

[[ $# -gt 0 ]] || { usage; exit 1; }
verb="$1"
shift

case "$verb" in
    -h|--help|help)
        usage
        exit 0 ;;
    craft)
        modules="block.sh craft.sh craft_verb.sh"
        entry=cmd_craft ;;
    link)
        modules="block.sh ownership.sh claude_settings.sh link.sh"
        entry=cmd_link ;;
    lint)
        modules="block.sh craft.sh catalog.sh lint.sh"
        entry=cmd_lint ;;
    *)
        echo "scio: unknown verb '$verb'" >&2
        usage >&2
        exit 1 ;;
esac

for module in $modules; do
    # shellcheck source=/dev/null
    . "$LIB/$module"
done
"$entry" "$@"
