__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/

# Node
node_modules/
npm-debug.log
yarn-error.log

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Logs
*.log

# OS
Thumbs.db

# Temporary files
*.tmp
*.bak

# refactor scratch (private paths)
.refactor/

# Skill design scratch / internal notes (not shipped with skills)
skills/_internal/

# Release artifacts (scripts/build-release.sh default --out).
# Ignored deliberately: the builder refuses a dirty tree, so a tracked-but-
# uncommitted artifact would make the NEXT release build impossible.
dist/
