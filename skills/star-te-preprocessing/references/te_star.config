// ---------- PIPELINE PARAMS ----------
params {
  // project-specific outdir set by CLI (below)
  // references (mm39 / GENCODE)
  fasta    = '/data1/shared/ref/mouse/Ensembl/mm39/GRCm39.genome.fa.gz'
  gtf      = '/data1/shared/ref/mouse/Ensembl/mm39/gencode.vM37.primary_assembly.annotation.gtf.gz'
  gencode  = true

  // keep both unsorted (STAR) and sorted/markdup BAMs
  save_align_intermeds = true

  // Qualimap hurts on HDDs; we skip it
  skip_qualimap = true
}

// ---------- CONTAINERS ----------
profiles {
  docker {
    docker.enabled = true
    docker.runOptions   = "-u ${System.env.NXF_UID ?: '1000'}:${System.env.NXF_GID ?: '1000'} -v /data2/nxf_tmp:/tmp"
    docker.fixOwnership = true
  }
}

// ---------- CORE NEXTFLOW ----------
workDir = "/data2/nf-work/${params.project ?: 'PROJECT'}/work"

env {
  // point all temp to the container’s /tmp (which is backed by /data2/nxf_tmp on the host)
  NXF_OPTS = '-Xms1g -Xmx4g -Djava.io.tmpdir=/tmp'
  TMPDIR   = '/tmp'
  NXF_TEMP = '/tmp'
}

timeline { overwrite = true }
report   { overwrite = true }

process {
  executor = 'local'

  // global cap to be gentle on HDD
  maxForks = 12

  // STAR can be I/O-heavy; keep parallelism conservative
  withName: /STAR_ALIGN/ {
    cpus = 8
    memory = '32 GB'
    maxForks = 2   // 2 (or 3 if disk is idle)
  }
  withName: /STAR_GENOMEGENERATE/ {
    cpus = 8
    memory = '32 GB'
    maxForks = 1
  }
  withName: /SAMTOOLS_SORT/ {
    cpus = 4
    memory = '16 GB'
    maxForks = 4
  }
  withName: /PICARD_MARKDUPLICATES/ {
    cpus = 4
    memory = '16 GB'
    maxForks = 2
  }

  // RSeQC read duplication can be very memory-intensive for large BAM files
  withName: /RSEQC_READDUPLICATION/ {
    cpus = 2
    memory = '64 GB'
    maxForks = 2
  }

  // generic labels
  withLabel: process_low    { cpus = 1;  memory = '4 GB'  }
  withLabel: process_medium { cpus = 4;  memory = '16 GB' }
  withLabel: process_high   { cpus = 8;  memory = '32 GB' }
}
