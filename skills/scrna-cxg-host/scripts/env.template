# env.template — copy to `.env` next to compose.yml and edit.
#
# This file is the single source of truth for project-and-server-specific values.
# `docker compose up` substitutes ${VAR} references in compose.yml from this file.
#
# Decision Pauses 2 (ports), 3 (htpasswd), 4 (paths) determine the values below.

# --- Hostname / network ---------------------------------------------------- #
# The HTTP host the wet lab will type into a browser. Resolves on the internal
# DNS (e.g., a CNAME you control). Used only by you for documenting the URL —
# nginx itself listens on `0.0.0.0` regardless.
HOSTNAME=cxg.research.example.org

# --- Host UID/GID ---------------------------------------------------------- #
# Run `id -u` and `id -g` as the user who owns the data and annotations.
# Mismatched UID makes annotation files root-owned and unwritable from outside
# the container — the Pitfall 'annotations dir owned by root' in SKILL.md.
UID=1000
GID=1000

# --- Host paths ------------------------------------------------------------ #
# DATA_HOST_PATH is mounted read-only into every cellxgene container at /data.
# It contains the prepared .h5ad files (output of Phase A / Phase A-bis).
DATA_HOST_PATH=/scratch/<project>/03_results/objects

# ANNOTATIONS_HOST_PATH is the *parent* of the per-dataset annotation dirs.
# The compose file mounts ${ANNOTATIONS_HOST_PATH}/<dataset>:/annotations.
# Each per-dataset dir must exist and be owned by ${UID}:${GID} before deploy.
ANNOTATIONS_HOST_PATH=/scratch/<project>/03_results/annotation

# --- Ports (one pair per dataset) ----------------------------------------- #
# Defaults: CXG 5005+, NGINX 8080+. The Decision Pause 'Port collision'
# (./scripts/check_ports.sh) replaces these on conflict.
CXG_PORT_FULL=5005
NGINX_PORT_FULL=8080

# Add one block per additional dataset:
# CXG_PORT_T_CELLS=5006
# NGINX_PORT_T_CELLS=8081
# CXG_PORT_B_CELLS=5007
# NGINX_PORT_B_CELLS=8082

# --- Project name (used in CXG titles) ------------------------------------ #
PROJECT_NAME=<ref-multi>
