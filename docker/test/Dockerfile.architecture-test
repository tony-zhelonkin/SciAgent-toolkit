FROM ubuntu:22.04

ARG DEBIAN_FRONTEND=noninteractive
ENV TZ=America/Chicago LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8

RUN apt-get update && apt-get install -y --no-install-recommends \
    bash coreutils findutils grep gawk sed diffutils \
    ca-certificates locales \
    && locale-gen en_US.UTF-8 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/sciagent
COPY . /opt/sciagent/
RUN ln -sf /opt/sciagent/bin/sciagent /usr/local/bin/sciagent

# Round-trip: activate → assert artefacts → deactivate → assert clean.
RUN set -eu && \
    mkdir -p /workspace/proj && cd /workspace/proj && \
    sciagent activate base >/dev/null && \
    test -L .claude/agents/code-reviewer.md && echo "  [OK] .claude/agents symlink" && \
    test -L .agents/agents/code-reviewer.md  && echo "  [OK] .agents/agents symlink" && \
    test -f .sciagent/manifest.json          && echo "  [OK] manifest written" && \
    grep -qF "<!-- BEGIN SCIAGENT:ROLES" AGENTS.md && echo "  [OK] managed block present" && \
    sciagent deactivate >/dev/null && \
    test ! -e .sciagent && echo "  [OK] manifest removed" && \
    test ! -L .claude/agents/code-reviewer.md && echo "  [OK] symlink removed" && \
    ! grep -qF "<!-- BEGIN SCIAGENT:ROLES" AGENTS.md 2>/dev/null && echo "  [OK] block removed from AGENTS.md (or file gone)"

# Full test suite gates the image build.
RUN bash /opt/sciagent/tests/run-all.sh

RUN echo "=== Architecture tests passed ===" > /tmp/test-success.txt

WORKDIR /workspace
CMD ["/bin/bash"]
