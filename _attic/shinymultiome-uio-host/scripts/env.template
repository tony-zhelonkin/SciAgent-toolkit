# env.template — copy to `.env` next to docker-compose.shinymultiome.yml and edit.
#
# Single source of truth for project-and-server-specific values. `render_compose.py`
# substitutes these into the compose / nginx / global.R templates.
#
# Decision Pauses S1 (genome), S2 (assay names), S3 (ports), S4 (htpasswd),
# S5 (paths), S6 (footprints) determine the values below.

# --- Hostname / network ---------------------------------------------------- #
# The HTTP host the wet lab will type into a browser. Used only for documenting
# the URL and for nginx server_name pattern matching; nginx listens on 0.0.0.0.
HOSTNAME=cxg.research.example.org

# --- Host UID/GID ---------------------------------------------------------- #
# Run `id -u` and `id -g` as the user who owns the data. Mismatched UID makes
# any container-side writes (logs) root-owned and unwritable from outside.
UID=1000
GID=1000

# --- Project name (used in app titles + image tags) ----------------------- #
PROJECT_NAME=<ref-multi>

# --- Genome (Decision Pause S1) ------------------------------------------- #
# Upstream ShinyMultiome.UiO hard-codes BSgenome.Hsapiens.UCSC.hg38. The skill's
# global.R.template reads BSGENOME_PKG and the Dockerfile installs whichever is
# named here. ENSDB_PKG is used by Phase A.2 to rebuild Annotation() if missing.
GENOME_LABEL=mm39
BSGENOME_PKG=BSgenome.Mmusculus.UCSC.mm39
ENSDB_PKG=EnsDb.Mmusculus.v107

# --- Assay names (Decision Pause S2) -------------------------------------- #
# Names AS STORED in the prepared .rds (after Phase A.1 normalisation).
# Upstream server.R expects: ATAC_ASSAY="peaks", RNA_ASSAY="RNA". If you chose
# Option B (parameterise upstream) in S2, adjust to your custom names AND patch
# scripts/overlay/.
ATAC_ASSAY=peaks
RNA_ASSAY=RNA

# --- Host paths (Decision Pause S5) --------------------------------------- #
# RDS_HOST_PATH: directory containing the prepared .rds (read-only mount → /data/rds).
RDS_HOST_PATH=/scratch/<project>/03_results/objects
RDS_FILENAME=S2_explore_shinymultiome.rds

# FRAGMENTS_HOST_PATH: directory containing fragments.tsv.gz + .tbi files
# (read-only mount → /data/fragments). Phase A.3 rewrites object's Fragments
# paths to point at /data/fragments inside the container.
FRAGMENTS_HOST_PATH=/scratch/<project>/03_results/fragments

# ANNOTATIONS_HOST_PATH: directory containing the htpasswd file (read-only).
# Reuse the H1 scrna-cxg-host annotations dir if sharing auth (Decision Pause S4 default).
ANNOTATIONS_HOST_PATH=/scratch/<project>/03_results/annotation

# --- Ports (Decision Pause S3) -------------------------------------------- #
# SHINY_PORT is the docker-network-internal port (browser never sees it).
# NGINX_PORT_SHINYMULTIOME is the host-facing port. Default 8090 is one step
# above the scrna-cxg-host range (8080+) to avoid collision with that stack.
SHINY_PORT=3838
NGINX_PORT_SHINYMULTIOME=8090

# --- Memory --------------------------------------------------------------- #
# Tune for object size. <30k cells: 8G; 30-80k: 16G; 80-200k: 32-48G; >200k:
# benchmark first. See references/shiny-memory-and-timeouts.md.
SHINYMULTIOME_MEM_LIMIT=32G
SHINYMULTIOME_MEM_RESERVATION=8G

# --- App defaults --------------------------------------------------------- #
# DEFAULT_REGION: gene name pre-filled in the Coverage tab on first load. Pick
# something known to be open in your dataset so the demo lands cleanly.
DEFAULT_REGION=Spp1

# Group-by columns the app exposes in dropdowns. Comma-separated. Each must be
# a column in obj@meta.data. Phase A.4 validates this list before save.
GROUP_BY_COLUMNS=cell_type,leiden_0.8,sample_id

# --- Optional: footprints (Decision Pause S6) ----------------------------- #
# If true, validate_signac_rds.R additionally checks @motifs and @positionEnrichment
# slots. Phase A.6 must have been run.
FOOTPRINTS_ENABLED=false
