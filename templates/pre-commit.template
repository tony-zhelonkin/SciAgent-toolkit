#!/usr/bin/env bash
set -euo pipefail
root=$(git rev-parse --show-toplevel)
# Found by its executable, so the vendored directory's name does not matter and
# the ADR-D9 rename needs no edit here.
for candidate in "$root"/01_modules/*/bin/scio; do
    if [[ -x "$candidate" ]]; then
        "$candidate" lint --project-dir "$root"
        break
    fi
done
