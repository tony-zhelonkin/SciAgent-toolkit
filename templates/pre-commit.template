#!/usr/bin/env bash
set -euo pipefail
root=$(git rev-parse --show-toplevel)
# Vendored copies predating the ADR-D9 rename are still at SciAgent-toolkit.
for name in scio SciAgent-toolkit; do
    candidate="$root/01_modules/$name/bin/scio"
    if [[ -x "$candidate" ]]; then
        "$candidate" lint --project-dir "$root"
        break
    fi
done
