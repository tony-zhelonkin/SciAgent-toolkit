# analysis_config.yaml — language-agnostic project configuration
# Template version: 2.1.0
#
# This file holds ALL project-specific values that must NOT be hardcoded in
# analysis scripts. It is the cross-language data contract: both R and Python read it.
#
# Usage:
#   R:      config <- yaml::read_yaml("02_analysis/config/analysis_config.yaml")
#   Python: with open("02_analysis/config/analysis_config.yaml") as f: config = yaml.safe_load(f)

# =============================================================================
# PROJECT METADATA
# =============================================================================

project:
  id: "{{PROJECT_ID}}"
  title: "{{PROJECT_TITLE}}"
  species: "{{SPECIES}}"              # e.g. "Mus musculus" / "Homo sapiens"
  species_db: "{{SPECIES_DB}}"        # e.g. "MM" / "HS"
  genome_build: "{{GENOME_BUILD}}"    # e.g. "mm10", "mm39", "hg38"

# =============================================================================
# EXPERIMENTAL DESIGN
# =============================================================================

design:
  groups:
    - "Control"                       # rename to your conditions
    - "Treatment"
  contrasts:
    - name: "Treatment_vs_Control"
      numerator: "Treatment"
      denominator: "Control"
  samples_per_group: null             # e.g. 5

# =============================================================================
# ANALYSIS THRESHOLDS
# =============================================================================

thresholds:
  # Differential Expression
  de_fdr: 0.05                        # FDR cutoff for significance
  de_logfc: 1.0                       # absolute log2FC cutoff (optional)

  # GSEA
  gsea_fdr: 0.05                      # FDR cutoff for pathway significance
  gsea_nperm: 100000                  # number of permutations
  gsea_seed: 123                      # random seed for reproducibility
  gsea_min_size: 15                   # minimum gene set size
  gsea_max_size: 500                  # maximum gene set size

# =============================================================================
# COLOR PALETTES (colorblind-safe)
# =============================================================================

colors:
  # Okabe-Ito palette for categorical data
  okabe_ito:
    orange: "#E69F00"
    sky_blue: "#56B4E9"
    bluish_green: "#009E73"
    yellow: "#F0E442"
    blue: "#0072B2"
    vermillion: "#D55E00"
    reddish_purple: "#CC79A7"
    black: "#000000"

  # Diverging scale for NES, logFC (blue = down, orange = up)
  diverging:
    down: "#2166AC"
    neutral: "#F7F7F7"
    up: "#B35806"

  # Group colors for sample comparisons
  groups:
    Control: "#56B4E9"
    Treatment: "#E69F00"

# =============================================================================
# FIGURES — the figure-style contract (read by figure_helpers.{R,py})
# =============================================================================
# Dual-context legibility: every figure must be readable BOTH shrunk in a
# journal column AND projected to the back of a conference room. The figure-
# style helper library reads this block. It is UNIFIED — ONE legible style tier
# (no print/screen split) emitted in BOTH formats: every figure is written as
# <name>.pdf (vector, cairo) AND <name>.png (raster) from one code path, same
# geometry, same theme. The font sizes below are FLOORS — raise, don't go under.

figures:
  # --- fonts (pt) — single tier (legible shrunk to a column AND projected) ---
  base_size: 14                       # base font (pt) FLOOR
  title_size: 16
  subtitle_size: 11
  axis_title_size: 13                 # plain (not bold)
  axis_text_size: 11
  strip_size: 12                      # facet strip labels (bold)
  legend_text_size: 11
  caption_size: 9
  label_size: 4                       # geom_text/geom_label size (ggplot mm)
  cue_size: 4                         # in-panel direction-cue text size
  line_width: 1.0                     # base line/segment width
  point_size: 2.4

  # --- geometry (inches) — ONE canvas shared by the pdf + png ----------------
  width: 8.5                          # default canvas
  height: 6.5
  width_wide: 13                      # two-column preset: save_figure(..., wide = TRUE)
  width_narrow: 6                     # single-column preset
  dpi: 300                            # raster dpi (png export)
  rasterized_dpi: 600                 # dpi for rasterized dense layers embedded in the vector PDF
                                      #   (mark them via rasterize_axes(); text/axes stay vector)
  formats: [pdf, png]                 # both emitted for every figure

  # --- anti-clutter / comparability ----------------------------------------
  top_n: 20                           # cap categorical axes to top-N
  volcano_label_top: 10               # top genes to label
  z_clamp: 2.5                        # clamp z-scores for shared color scales
  nes_cap: 3.5                        # clamp NES for comparable bar lengths
  running_sum_ylim: [-1.0, 1.0]       # shared running-ES y-range (comparable curves)
  running_sum_top: 5                  # # of curves per running-sum panel (top-N by |NES|)
  running_sum_heights: [2.4, 0.7, 0.9] # ES : rug : metric panel-height proportions
  caption_wrap_column: 70             # README caption wrap width

  # --- results sub-layout directory names (results placement contract) ------
  by_contrast_dir: "by_contrast"      # 03_results/<stage>/figures/by_contrast/<c>/
  overview_dir: "_overview"           # 03_results/<stage>/figures/_overview/

# =============================================================================
# INTERACTIVE — the interactive breakpoint explorer contract
# =============================================================================
# Read by lib/interactive-style/interactive_helpers.py and by the project's
# export_explorers.py. At a pipeline inflection point, a live-kernel Python .qmd
# drives jscatter linked panels to brush/lasso cells, then persists barcodes + a
# labelled snapshot that FEEDS the decision gate (see skill:
# interactive-breakpoint-explorer). All lists are EMPTY by default — fill per
# project; the helper lib hardcodes no project-specific columns. Export-first:
# the exporter materializes compact parquet under 03_results/interactive/ so the
# live kernel never opens the multi-GB .h5ad.

interactive:
  # --- exporter: which checkpoints to materialize + which embedding is x,y ---
  export_stages: []          # stage ids to build <stage>_explore.parquet for
  load_coords_obsm: ""       # obsm key read as x,y, e.g. "X_umap"

  # --- exporter: overlays added as explorer columns --------------------------
  marker_genes: []           # marker genes added per cell, e.g. [FOXP3, CD8A]
  signatures: {}             # named gene sets scored per cell, e.g. {score_x: [G1, G2]}

  # --- notebook grid: panel layout + coloring --------------------------------
  categorical_obs: []        # obs columns grid() ALWAYS treats categorical
  grid_rows: 2               # rows in the composed panel layout
  grid_height: 340           # per-panel pixel height
  cmap: magma                # continuous colormap for grid() + snapshot()

  # --- save_selection: what to persist + how to summarize a selection --------
  save_selection_cols: [x, y]  # columns written per selection CSV (extend; do not shrink)
  summary_stats: []          # composition stats: {name, column, value?} (value -> fraction; else modal level)

# =============================================================================
# DATABASES TO ANALYZE
# =============================================================================

databases:
  msigdb:
    - { category: "H",  subcategory: "",            name: "Hallmark" }
    - { category: "C2", subcategory: "CP:KEGG",     name: "KEGG" }
    - { category: "C2", subcategory: "CP:REACTOME", name: "Reactome" }
    - { category: "C5", subcategory: "GO:BP",       name: "GO_BP" }
  custom: []
    # - { path: "00_data/references/custom_gene_sets.csv", name: "Custom" }

# =============================================================================
# ANALYSIS STAGES
# =============================================================================
# Each stage owns 03_results/<id>/{tables,figures}/, created on first write.
# Stage id = NN_<slug>: zero-padded two-digit prefix + lowercase snake_case (<=2 words).
# Append a new entry here BEFORE any script writes artifacts to that stage.

stages:
  - id: "01_qc"
    title: "Quality control"
    purpose: "Filter cells/samples, flag doublets, gate on QC metrics."
  - id: "02_eda"
    title: "Exploratory analysis"
    purpose: "Embeddings, clustering, first-pass structure of the data."

# =============================================================================
# INPUT/OUTPUT PATHS (relative to project root)
# =============================================================================

paths:
  # Input
  references: "00_data/references/"

  # Output roots — phase-based layout. Checkpoint state is separate from deliverables.
  results: "03_results/"              # results root
  objects: "03_results/objects/"      # reusable state (.h5ad, .rds) — NOT a deliverable
  master: "03_results/master/"        # cross-stage accumulator tables
  interactive: "03_results/interactive/"  # standalone HTML dashboards
  scratch: "03_results/_scratch/"     # throwaway plots/tables

  # Per-stage directories — <stage_id>/{tables,figures}/.
  # Resolve with the config loader (e.g. stage_dir("01_qc", "figures")); do not hardcode.
  stage_tables_subdir: "tables"
  stage_figures_subdir: "figures"

  # Toolkits
  rnaseq_toolkit: "01_modules/RNAseq-toolkit/"
  sciagent_toolkit: "01_modules/SciAgent-toolkit/"

# =============================================================================
# SCHEMA DEFINITIONS (for validation)
# =============================================================================

schemas:
  master_gsea_table:
    required_columns:
      - pathway_id
      - pathway_name
      - database
      - nes
      - pvalue
      - padj
      - set_size
      - core_enrichment
      - contrast
      - direction
  master_de_table:
    required_columns:
      - gene_symbol
      - logFC
      - P.Value
      - adj.P.Val
      - contrast
      - significant
      - direction
